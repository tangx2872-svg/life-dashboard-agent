{
  "name": "life-dashboard-standalone",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.7.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --env-file-if-exists=.env --test tests/*.test.mjs",
    "local:mysql": "node scripts/local-mysql.mjs",
    "stop:mysql": "node scripts/local-mysql.mjs stop",
    "build": "node scripts/check-frontend.mjs --build",
    "lint": "node scripts/check-frontend.mjs",
    "start:integrated": "node scripts/start-integrated.mjs --ai=external",
    "start:full": "node scripts/start-integrated.mjs --ai=local",
    "start:mock": "node scripts/start-integrated.mjs --ai=mock",
    "test:integration": "node --env-file-if-exists=.env --test tests/ai-stack.integration.mjs",
    "test:ai": "node scripts/test-ai.mjs",
    "test:live": "node --env-file-if-exists=.env --test tests/ai-live.integration.mjs"
  },
  "dependencies": {
    "mysql2": "3.24.6"
  }
}
