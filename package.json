{
  "name": "life-dashboard-standalone",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --env-file-if-exists=.env --test tests/*.test.mjs",
    "local:mysql": "node scripts/local-mysql.mjs",
    "stop:mysql": "node scripts/local-mysql.mjs stop"
  },
  "dependencies": {
    "mysql2": "3.24.6"
  }
}
