# Production HTTPS: set NODE_ENV=production; see docs/SERVER_DEPLOYMENT.md
NODE_ENV=development
PUBLIC_ORIGIN=http://127.0.0.1:3000
PORT=3000
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=life_dashboard
MYSQL_PASSWORD=replace_with_your_database_password
MYSQL_DATABASE=life_dashboard

# External AI Backend (no model API key in this application)
AI_BACKEND_BASE_URL=http://127.0.0.1:6016
AI_BACKEND_TIMEOUT_S=90
