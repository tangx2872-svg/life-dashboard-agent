# ============================================================
# 复制本文件为 .env 后按需填写（.env 已被 .gitignore 忽略，禁止提交）
#   cp .env.example .env
# 说明：只写字段名，不写任何真实 Key
# ============================================================

# ---------------- 应用 ----------------
APP_ENV=development
HOST=127.0.0.1
PORT=6006
LOG_LEVEL=INFO
DEBUG=false

# ---------------- Provider 选择 ----------------
# ASR: funasr | openai | mock
# 当前已验证通过的正式组合是 ASR=mock + LLM=autodl；
# funasr 需要额外 pip install funasr（会附带 torch），不装也能启动服务。
ASR_PROVIDER=mock
# LLM: openai | local_qwen | mock
LLM_PROVIDER=autodl

# ---------------- AutoDL OpenAI-compatible API（LLM）----------------
# 注意：这是 AutoDL 的兼容接口，不是 OpenAI 官方地址。
# 真实 Key 只允许写入 .env（已被 .gitignore 忽略），本文件只放字段名，值留空。
AUTODL_LLM_API_KEY=
AUTODL_LLM_BASE_URL=https://www.autodl.art/api/v1
AUTODL_LLM_MODEL=gpt-5.6-luna
AUTODL_LLM_TIMEOUT_S=120
AUTODL_LLM_MAX_RETRIES=2
# auto | on | off —— 是否尝试使用 Responses API 的结构化输出（json_schema）
AUTODL_LLM_STRUCTURED=auto

# ---------------- OpenAI（ASR + LLM 共用；只从环境变量读取）----------------
# 没有 Key 时服务依然可以启动，调用 OpenAI Provider 时才报错
OPENAI_API_KEY=
# 可选：兼容 OpenAI 接口的网关 / 代理地址，留空使用官方地址
OPENAI_BASE_URL=
# 语义解析模型（Responses API），名称请在官方控制台确认后填写
OPENAI_MODEL=
# 语音转写模型（audio/transcriptions），例如 gpt-4o-mini-transcribe 一类，请按官方当前支持填写
OPENAI_TRANSCRIBE_MODEL=
OPENAI_TIMEOUT_S=120
OPENAI_MAX_RETRIES=2

# ---------------- FunASR（本地中文 ASR）----------------
# 可以是 ModelScope 模型名，也可以是本地绝对路径
FUNASR_MODEL=paraformer-zh
FUNASR_MODEL_REVISION=
# cuda:0 使用 GPU；cpu 使用 CPU
FUNASR_DEVICE=cuda:0
# 留空表示不启用对应模块
FUNASR_VAD_MODEL=fsmn-vad
FUNASR_PUNC_MODEL=ct-punc
FUNASR_LANGUAGE=zh

# ---------------- 本地 Qwen（第一轮：只做文本生成测试）----------------
# 大模型缓存统一指向数据盘（系统盘只有 30G）
HF_HOME=/root/autodl-tmp/models/huggingface
TRANSFORMERS_CACHE=/root/autodl-tmp/models/huggingface
MODELSCOPE_CACHE=/root/autodl-tmp/models/modelscope
# 官方模型标识；LOCAL_LLM_MODEL_PATH 填本地快照绝对路径时可离线加载
LOCAL_LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507
LOCAL_LLM_MODEL_PATH=
LOCAL_LLM_DEVICE=cuda:0
# bfloat16 | float16 | float32（第一轮不量化）
LOCAL_LLM_DTYPE=bfloat16
LOCAL_LLM_MAX_NEW_TOKENS=256

# ---------------- 上传 ----------------
UPLOAD_MAX_MB=20

# ---------------- 路径 ----------------
# 大型模型放数据盘，避免占满 30G 系统盘
MODEL_DIR=/root/autodl-tmp/models
UPLOAD_DIR=
# ffmpeg 可执行文件；webm/m4a 转码需要
FFMPEG_BIN=ffmpeg

# ---------------- 语义解析默认值 ----------------
DEFAULT_LOCALE=zh-CN
DEFAULT_TIMEZONE=Asia/Shanghai
MAX_TEXT_CHARS=4000

# ---------------- Mock Provider（开发自测用）----------------
MOCK_ASR_TEXT=明天下午三点开会
